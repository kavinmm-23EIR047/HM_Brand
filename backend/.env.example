# Server & Environment
PORT=5000
NODE_ENV=development
NODE_VERSION=20
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL / Prisma Postgres)
# Example Prisma Postgres: postgres://<user>:<api_key>@pooled.db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hm_agarbattis_db?schema=public"

# Authentication Secrets
JWT_SECRET=super-secret-hm-agarbattis-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-hm-agarbattis-refresh-key-change-in-production

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
