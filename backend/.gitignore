# ==============================================================================
# HM Brand Backend .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/

# Compilation & Build outputs
dist/
build/
*.tsbuildinfo

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
.env*.local
*.env
*.pem
*.key
*.cert
*.crt
*service-account*.json
*credentials*.json
!/.env.example

# SQLite & Local Databases
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.sqlite

# Local Runtime Data & Customer Leads
data/
uploads/
storage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
