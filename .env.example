# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_DELIVERY_FEE_ENABLED=true
NEXT_PUBLIC_DELIVERY_FEE=50
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD=500
NEXT_PUBLIC_DELIVERY_ESTIMATE=3–5 business days

# AI Chatbot & Voice Consultation (Gemini & Google Cloud Text-to-Speech)
GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TTS_VOICE_TA=ta-IN-Wavenet-A
TTS_VOICE_EN=en-IN-Neural2-A

# NVIDIA NIM API (Free credits at https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
